<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OnePulse.App.Gui.Pages.User.UserAddPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conventers="using:OnePulse.App.Gui.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OnePulse.App.Gui.Pages.User"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conventers:InvertBoolConverter x:Key="InvertBoolConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="26,10,0,0"
            FontSize="28"
            FontWeight="Bold"
            Text="新建用户" />

        <Grid
            Grid.Row="1"
            Padding="64,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Rectangle
                Width="256"
                Height="256"
                Fill="#DDD"
                RadiusX="12"
                RadiusY="12"
                Stroke="{ThemeResource ControlFillColorDefaultBrush}"
                StrokeThickness="4" />

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <TextBlock Text="用户名: " />
                <TextBox
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.UserName, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Text="密码: " />
                <PasswordBox
                    Grid.Row="3"
                    x:Name="PasswordInputBox"
                    PasswordChanged="PasswordInputBox_PasswordChanged" />

                <ScrollView Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox
                            x:Name="ValidationCheckBox"
                            Content="需要验证是否有效"
                            IsChecked="{x:Bind ViewModel.NeedValidation, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.NeedLoginAndEnter, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
                        <CheckBox
                            x:Name="LoginAndEnterCheckBox"
                            Content="登录并进入"
                            IsChecked="{x:Bind ViewModel.NeedLoginAndEnter, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollView>

                <StackPanel
                    Grid.Row="5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button Content="登录" Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        x:Name="CancelButton"
                        Click="CancelButton_Click"
                        Content="取消" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
