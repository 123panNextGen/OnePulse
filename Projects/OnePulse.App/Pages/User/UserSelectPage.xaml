<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OnePulse.App.Pages.User.UserSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OnePulse.App.Pages.User"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userInfo="using:OnePulse.Pan123.Api.Models.UserInfo"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="UserInfoListViewTemplate" x:DataType="userInfo:UserInfo">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        x:Name="Ellipse"
                        Grid.RowSpan="2"
                        Width="32"
                        Height="32"
                        Margin="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="Gray" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,6,0,0"
                        x:Phase="1"
                        Style="{ThemeResource BaseTextBlockStyle}"
                        Text="{x:Bind OpenInfo.Nickname}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,0,0,6"
                        x:Phase="2"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind OpenInfo.Passport}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="26,10,0,0"
            FontSize="28"
            FontWeight="Bold"
            Text="欢迎回来" />

        <Grid Grid.Row="1">
            <ListView
                x:Name="UserInfoListView"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ItemTemplate="{StaticResource UserInfoListViewTemplate}"
                SelectionMode="Single" />
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="0,0,24,12"
            HorizontalAlignment="Right"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Content="登录"
                Style="{StaticResource AccentButtonStyle}" />
            <Button Grid.Column="1" Content="新建" />
            <Button
                Grid.Column="2"
                Content="更多操作"
                Style="{StaticResource SubtleButtonStyle}" />
        </Grid>
    </Grid>
</Page>
