<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OnePulse.App.Windows.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OnePulse.App.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userInfo="using:OnePulse.Pan123.Api.Models.UserInfo"
    Title="LoginWindow"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="ContactListViewTemplate" x:DataType="userInfo:UserInfo">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        x:Name="Ellipse"
                        Grid.RowSpan="2"
                        Width="32"
                        Height="32"
                        Margin="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="Gray" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,6,0,0"
                        x:Phase="1"
                        Style="{ThemeResource BaseTextBlockStyle}"
                        Text="{x:Bind OpenInfo.Nickname}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,0,0,6"
                        x:Phase="2"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind OpenInfo.Passport}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="OnePulse"
            Subtitle="Login">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE77B;" />
            </TitleBar.IconSource>
        </TitleBar>

        <ListView
            Grid.Row="2"
            ItemTemplate="{StaticResource ContactListViewTemplate}"
            SelectionMode="Single" />

    </Grid>
</Window>
